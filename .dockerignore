# 이미지에 넣지 않을 것 — 빌드 컨텍스트에서 제외.

# 가상환경·파이썬 캐시
.venv/
__pycache__/
*.pyc

# 비밀정보
.env

# 저작권 자료 (교재 자료·실제 정답 DB) — 절대 이미지에 넣지 않는다.
# 정답 DB는 런타임에 볼륨(/answers)으로만 주입한다. 이미지에 굽지 않는다.
samples/
*.pdf
db.ssen*.json
answer/
request*.json
exam_myexam.*

# 개인 사진·추론 결과
test_images/
pred_*
synth_*.png

# 모델 가중치·학습 산출물
*.pt
runs/
data/

# 서버가 런타임에 /openapi.json으로 새로 생성한다 — static 스냅샷은 이미지에 불필요
# (repo에는 Java SDK 생성용으로 계속 커밋해 둔다)
openapi.json

# VCS·CI·에디터
.git/
.github/
.gitignore

# 향후 산출물 (파이썬 이미지엔 불필요)
client-java/

# macOS
.DS_Store
