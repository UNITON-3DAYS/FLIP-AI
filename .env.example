# FLIP 채점 파이프라인 환경변수 예시.
# 복사해서 사용: cp .env.example .env  (.env는 gitignore 대상 — 실제 키를 여기에 쓰지 마라)

# ── 채점 파이프라인 선택 (grade.py) ──
# blocks  : OCR로 쪽수·문제 블록을 절단해 문제별 크롭을 VLM에 판독 (문제별 2회검증)
# fullpage: OCR 없이 페이지 전체를 VLM 1콜로 판독 — RAM 0(Paddle 미로드)·토큰 ~1/5·~3배 빠름
#           (쪽수도 VLM이 읽는다). 정확도는 실측 동률(7/7), 문제별 재검증은 없음.
FLIP_GRADER=blocks

# ── 주관식 손글씨 인식 VLM API (flip/vlm.py, spike_vlm.py) ──
# provider: openai | gemini | anthropic
FLIP_VLM_PROVIDER=openai
FLIP_VLM_API_KEY=your-api-key-here
# 모델 ID는 provider 문서의 정확한 문자열로 (예: gpt-5.6-luna, gemini-2.5-flash)
# 생략 시 provider별 기본값: gpt-5.6-luna / gemini-2.5-flash / claude-opus-5
# Gemini로 A/B: FLIP_VLM_PROVIDER=gemini + FLIP_VLM_API_KEY에 Gemini 키 (키는 provider당 1개 슬롯)
FLIP_VLM_MODEL=
# reasoning effort (기본 low — 미지정 시에도 low로 보낸다. 크롭 읽기는 단순 작업이라
# 낮을수록 빠름. OpenAI 기본 medium은 콜이 12~13초까지 늘어남 실측).
# reasoning 미지원 모델이면 빈 값(FLIP_VLM_REASONING=)으로 두면 파라미터를 안 보낸다.
FLIP_VLM_REASONING=low
# 동시 VLM API 호출 수의 전역 상한 (기본 8). 페이지·문제 병렬이 이 값 하나로 캡되어
# provider rate limit을 넘지 않는다. 429가 잦으면 낮추고, 여유 있으면 올려 처리량↑.
FLIP_VLM_CONCURRENCY=8

# ── 배포 (docker-compose.yml, CD) ──
# 서버가 띄울 이미지. 로컬은 비워두면 flip-ai:latest로 빌드해서 뜬다.
# 서버에선 deploy-prod.yml이 매 배포마다 DockerHub 태그(prod-<sha>)로 덮어쓰므로 손대지 말 것.
FLIP_DOCKER_IMAGE=

# ── 서버 기동 (api/main.py) ──
# 1(기본): 첫 요청 전에 OCR 엔진을 미리 로드(blocks 그레이더). 0이면 건너뛰고 첫 요청에서
# 지연 로드 — CI 헬스체크나 빠른 기동, fullpage 그레이더(OCR 불필요)일 때 0으로.
FLIP_WARMUP_OCR=1

# ── 샘플 준비 ──
# 테스트용 문제집 PDF 경로 (페이지 렌더링용. PDF 자체는 커밋 금지 — gitignore *.pdf)
FLIP_SAMPLE_PDF=/path/to/workbook.pdf

# ── 정답 소스 (flip/answers.py) ──
# book(교재 이름)으로 정답을 조회하는 백엔드 선택. 서버(api)는 이 값만 바꾸면 저장소가
# 로컬 JSON인지 MySQL인지 몰라도 된다. 서버(운영)는 mysql, 로컬 테스트는 json이 편하다.
FLIP_ANSWER_BACKEND=json
# json 백엔드: 정답 JSON들이 있는 디렉터리. 저작권 자료라 repo에 안 넣고 여기로 주입.
# (파일명이 아니라 JSON 안의 "book" 필드로 매칭한다)
FLIP_ANSWER_DIR=.
# mysql 백엔드: Backend와 같은 GCP MySQL을 읽는다(읽기 전용, SELECT만).
# question⨝worksheet를 title(=교재명)으로 조회. 접속정보는 비밀이라 서버에선 CD가 주입.
FLIP_MYSQL_HOST=
FLIP_MYSQL_PORT=3306
FLIP_MYSQL_DB=flip
FLIP_MYSQL_USER=flip
FLIP_MYSQL_PASSWORD=
