# FLIP 환경변수. 사용: cp .env.example .env  (실제 키는 .env에만 — gitignore 대상)

# 채점 파이프라인: fullpage(페이지 전체 1콜) | blocks(OCR 블록절단 + 문제별 크롭)
FLIP_GRADER=fullpage

# VLM (flip/vlm.py). provider: gemini(기본) | openai | anthropic
FLIP_VLM_PROVIDER=gemini
FLIP_VLM_API_KEY=your-api-key-here
FLIP_VLM_MODEL=            # 생략 시 기본: gemini-2.5-flash / gpt-5.6-luna / claude-opus-5
FLIP_VLM_BASE_URL=         # openai 호환 엔드포인트 교체용 (예: https://openrouter.ai/api/v1 + 모델 qwen/qwen3-vl-235b-a22b-instruct)
FLIP_VLM_REASONING=low     # openai 전용. reasoning 미지원 모델은 빈 값
FLIP_VLM_THINKING=0        # gemini 전용 사고 제한. 숫자=thinkingBudget(2.5), low|high=thinkingLevel(3.x), 빈 값=파라미터 생략
# FLIP_VLM_MEDIA_RES=MEDIA_RESOLUTION_HIGH   # gemini 이미지 해상도. 미설정=코드 default HIGH(마킹 판독 필수, secret 불필요). LOW/MEDIUM로 낮추거나, 미지원 모델이 400 내면 빈 값(FLIP_VLM_MEDIA_RES=)으로 끔
FLIP_VLM_CONCURRENCY=8     # 동시 API 호출 상한 (429 잦으면 낮출 것)

# 배포/서버
FLIP_DOCKER_IMAGE=         # 비우면 로컬 빌드. 서버는 CD가 덮어씀
FLIP_WARMUP_OCR=1          # blocks용 OCR 사전로드. fullpage면 0
FLIP_SAMPLE_PDF=/path/to/workbook.pdf

# 정답 소스 (flip/answers.py): json(로컬) | mysql(운영, CD가 접속정보 주입)
FLIP_ANSWER_BACKEND=json
FLIP_ANSWER_DIR=.          # 정답 JSON 디렉터리 ("book" 필드로 매칭)
FLIP_MYSQL_HOST=
FLIP_MYSQL_PORT=3306
FLIP_MYSQL_DB=flip
FLIP_MYSQL_USER=flip
FLIP_MYSQL_PASSWORD=
